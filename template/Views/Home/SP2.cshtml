@{
    ViewBag.Title = "SP1";
    Layout = "~/Views/Home/mau1.cshtml";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi tiết sản phẩm</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #fff;
            padding: 20px;
        }

        .product-page {
            display: flex;
            gap: 25px;
            max-width: 1200px;
            margin: 0 auto;
            color: #111;
            align-items: flex-start;
            background: #fff;
            padding: 20px;
        }

        /* Cột ảnh thu nhỏ bên trái */
        .thumb {
            display: flex;
            flex-direction: column;
            gap: 10px;
            width: 75px;
            flex-shrink: 0;
        }

        .box {
            width: 75px;
            height: 75px;
            border: 1px solid #ddd;
            border-radius: 6px;
            overflow: hidden;
            cursor: pointer;
            opacity: 0.7;
            transition: all 0.2s;
        }

            .box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .box:hover,
            .box.active {
                border-color: #0056fb;
                opacity: 1;
            }

        /* Khung ảnh showcase lớn ở giữa */
        .product-showcase {
            flex: 1.2;
            border: 1px solid #eee;
            border-radius: 12px;
            padding: 40px 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #fff;
        }

        .showcase-wrapper {
            position: relative;
            width: 100%;
            max-width: 420px;
        }

        .main-image {
            width: 100%;
            height: auto;
            display: block;
        }

        /* Cột thông tin sản phẩm bên phải */
        .product-details {
            flex: 1.2;
            padding-top: 5px;
        }

        .product-brand {
            font-size: 13px;
            color: #666;
            margin-bottom: 6px;
            display: block;
        }

        .product-title {
            font-size: 22px;
            font-weight: 700;
            margin: 0 0 12px 0;
            line-height: 1.35;
        }

        .product-rating {
            font-size: 14px;
            margin-bottom: 15px;
        }

            .product-rating .stars {
                color: #f5a623;
                font-weight: 600;
            }

            .product-rating .reviews {
                color: #666;
                margin-left: 5px;
            }

        .product-price {
            font-size: 24px;
            font-weight: 700;
            color: #111;
            margin-bottom: 20px;
        }

        .divider {
            border: none;
            border-top: 1px solid #eee;
            margin: 20px 0;
        }


        .product-color-section {
            margin-top: 15px;
        }

        .color-label {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
            display: block;
        }

        .color-options {
            display: flex;
            gap: 10px;
        }

        .color-box {
            width: 60px;
            height: 60px;
            border: 1px solid #ddd;
            border-radius: 6px;
            overflow: hidden;
            cursor: pointer;
            padding: 3px;
            transition: all 0.2s;
        }

            .color-box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 4px;
            }

            .color-box.active {
                border-color: #0056fb;
                box-shadow: 0 0 0 1px #0056fb;
            }

        .product-action-section {
            margin-top: 20px;
        }

        .quantity-label {
            font-size: 14px;
            color: #333;
            margin-bottom: 8px;
            display: block;
        }

        .action-wrapper {
            display: flex;
            gap: 15px;
            align-items: center;
        }


        .quantity-selector {
            display: flex;
            align-items: center;
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
            background: #fff;
            width: 120px;
            height: 48px;
        }

            .quantity-selector button {
                flex: 1;
                background: transparent;
                border: none;
                font-size: 18px;
                cursor: pointer;
                color: #333;
                height: 100%;
            }

                .quantity-selector button:hover {
                    background: #f5f5f5;
                }

            .quantity-selector input {
                width: 40px;
                border: none;
                text-align: center;
                font-size: 16px;
                font-weight: 600;
                color: #111;
                background: transparent;
            }


        .btn-buy-now {
            flex: 1;
            height: 48px;
            background-color: #0056fb;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
            white-space: nowrap;
        }

            .btn-buy-now:hover {
                background-color: #0043c7;
            }

        .product-specs-container {
            max-width: 1200px;
            margin: 30px auto 0 auto;
            background: #fff;
            padding: 0 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .spec-row {
            display: flex;
            padding: 18px 0;
            border-bottom: 1px solid #eee;
            align-items: flex-start;
        }

        .spec-label {
            width: 220px;
            font-weight: 600;
            color: #111;
            font-size: 15px;
        }

        .spec-value {
            flex: 1;
            color: #333;
            font-size: 15px;
            line-height: 1.6;
        }

        .thongtin {
            margin-left: 60px;
            font-size: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
    </style>
    <script src="~/Scripts/script/Sanpham.js"></script>
</head>
<body>
    <div class="product-page">

        <div class="thumb">
            <div class="box active" onclick="openImage(this)">
                <img src="~/Content/image2/8.jpg" alt="">
            </div>
            <div class="box" onclick="openImage(this)">
                <img src="~/Content/image2/9.jpg" alt="">
            </div>
            <div class="box" onclick="openImage(this)">
                <img src="~/Content/image2/10.jpg" alt="">
            </div>
        </div>


        <div class="product-showcase">
            <div class="showcase-wrapper">
                <img src="~/Content/image2/8.jpg" alt="main-image" class="main-image">
            </div>
        </div>

        <div class="product-details">
            <span class="product-brand">Razer</span>
            <h1 class="product-title">Razer BlackWidow V4 Tenkeyless HyperSpeed Wuthering Waves Edition</h1>

            <div class="product-rating">
                <span class="stars">⭐ 5.0</span>
                <span class="reviews">(25 đánh giá)</span>
            </div>

            <div class="product-price">3.576.000₫</div>

            <hr class="divider">

        </div>
        </br>
        <div class="product-action-section">
            <span class="quantity-label">Số lượng:</span>
            <div class="action-wrapper">
                <div class="quantity-selector">
                    <button type="button" onclick="decreaseQty()">-</button>
                    <input type="text" id="quantity-input" value="1" readonly>
                    <button type="button" onclick="increaseQty()">+</button>
                </div>
                <button type="button" class="btn-buy-now">ADD TO CART</button>
            </div>
        </div>
    </div>
    <div class="decription">
        <div class="thongtin">
            Khơi dậy ý chí kiên định để chinh phục thế giới hậu Lament. Mẫu bàn phím gaming không dây này mang đến hiệu năng độ trễ thấp, hỗ trợ thay nóng switch (Hot-Swap) và sở hữu thiết kế Tenkeyless (TKL) gọn gàng, giúp bạn kiểm soát mọi thao tác với độ chính xác tối đa.
            Kết nối Razer™ HyperSpeed Wireless & Bluetooth
            Thiết kế hỗ trợ Hot-Swap
            Trải nghiệm gõ được tối ưu hóa</div">

        </div>

        <div class="product-specs-container">
            <div class="spec-row">
                <div class="spec-label">Kích thước</div>
                <div class="spec-value">TKL</div>
            </div>
            <div class="spec-row">
                <div class="spec-label">Keycap</div>
                <div class="spec-value">ABS doubleshot</div>
            </div>
            <div class="spec-row">
                <div class="spec-label">Switch</div>
                <div class="spec-value">Razer™ Mechanical Switches Gen-3 (Tactile)</div>
            </div>
            <div class="spec-row">
                <div class="spec-label">Kết nối</div>
                <div class="spec-value">
                    Razer™ HyperSpeed Wireless (2.4 GHz)<br>
                    Bluetooth<br>
                    Cáp USB Type C
                </div>
            </div>
            <div class="spec-row">
                <div class="spec-label">Tương thích</div>
                <div class="spec-value">Windows</div>
            </div>
            <div class="spec-row">
                <div class="spec-label">Thông số khác</div>
                <div class="spec-value">
                    Razer™ Snap Tap<br>
                    Hỗ trợ Razer™ Synapse 4<br>
                    Khung mặt trên bằng hợp kim nhôm 5052<br>
                    Plate thép gắn kiểu Top-Mount<br>
                    Vỏ mặt dưới bằng nhựa ABS<br>
                    Tích hợp lớp foam tiêu âm cho PCB và vỏ bàn phím<br>
                    Stabilizer plate-mount được bôi trơn sẵn<br>
                    Polling Rate 1.000Hz<br>
                    N-Key Rollover & Anti-Ghosting
                </div>
            </div>
        </div>
</body>
</html>