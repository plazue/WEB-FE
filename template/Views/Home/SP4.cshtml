@{
    ViewBag.Title = "SP1";
    Layout = "~/Views/Home/mau1.cshtml";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi tiết sản phẩm</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #fff;
            padding: 20px;
        }

        .product-page {
            display: flex;
            gap: 25px;
            max-width: 1200px;
            margin: 0 auto;
            color: #111;
            align-items: flex-start;
            background: #fff;
            padding: 20px;
        }

        /* Cột ảnh thu nhỏ bên trái */
        .thumb {
            display: flex;
            flex-direction: column;
            gap: 10px;
            width: 75px;
            flex-shrink: 0;
        }

        .box {
            width: 75px;
            height: 75px;
            border: 1px solid #ddd;
            border-radius: 6px;
            overflow: hidden;
            cursor: pointer;
            opacity: 0.7;
            transition: all 0.2s;
        }

            .box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .box:hover,
            .box.active {
                border-color: #0056fb;
                opacity: 1;
            }

        /* Khung ảnh showcase lớn ở giữa */
        .product-showcase {
            flex: 1.2;
            border: 1px solid #eee;
            border-radius: 12px;
            padding: 40px 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #fff;
        }

        .showcase-wrapper {
            position: relative;
            width: 100%;
            max-width: 420px;
        }

        .main-image {
            width: 100%;
            height: auto;
            display: block;
        }

        /* Cột thông tin sản phẩm bên phải */
        .product-details {
            flex: 1.2;
            padding-top: 5px;
        }

        .product-brand {
            font-size: 13px;
            color: #666;
            margin-bottom: 6px;
            display: block;
        }

        .product-title {
            font-size: 22px;
            font-weight: 700;
            margin: 0 0 12px 0;
            line-height: 1.35;
        }

        .product-rating {
            font-size: 14px;
            margin-bottom: 15px;
        }

            .product-rating .stars {
                color: #f5a623;
                font-weight: 600;
            }

            .product-rating .reviews {
                color: #666;
                margin-left: 5px;
            }

        .product-price {
            font-size: 24px;
            font-weight: 700;
            color: #111;
            margin-bottom: 20px;
        }

        .divider {
            border: none;
            border-top: 1px solid #eee;
            margin: 20px 0;
        }


        .product-color-section {
            margin-top: 15px;
        }

        .color-label {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
            display: block;
        }

        .color-options {
            display: flex;
            gap: 10px;
        }

        .color-box {
            width: 60px;
            height: 60px;
            border: 1px solid #ddd;
            border-radius: 6px;
            overflow: hidden;
            cursor: pointer;
            padding: 3px;
            transition: all 0.2s;
        }

            .color-box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 4px;
            }

            .color-box.active {
                border-color: #0056fb;
                box-shadow: 0 0 0 1px #0056fb;
            }

        .product-action-section {
            margin-top: 20px;
        }

        .quantity-label {
            font-size: 14px;
            color: #333;
            margin-bottom: 8px;
            display: block;
        }

        .action-wrapper {
            display: flex;
            gap: 15px;
            align-items: center;
        }


        .quantity-selector {
            display: flex;
            align-items: center;
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
            background: #fff;
            width: 120px;
            height: 48px;
        }

            .quantity-selector button {
                flex: 1;
                background: transparent;
                border: none;
                font-size: 18px;
                cursor: pointer;
                color: #333;
                height: 100%;
            }

                .quantity-selector button:hover {
                    background: #f5f5f5;
                }

            .quantity-selector input {
                width: 40px;
                border: none;
                text-align: center;
                font-size: 16px;
                font-weight: 600;
                color: #111;
                background: transparent;
            }


        .btn-buy-now {
            flex: 1;
            height: 48px;
            background-color: #0056fb;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
            white-space: nowrap;
        }

            .btn-buy-now:hover {
                background-color: #0043c7;
            }
        /* Khung chứa thông số kỹ thuật ở dưới */
        .product-specs-container {
            max-width: 1200px;
            margin: 30px auto 0 auto;
            background: #fff;
            padding: 0 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .spec-row {
            display: flex;
            padding: 18px 0;
            border-bottom: 1px solid #eee;
            align-items: flex-start;
        }

        .spec-label {
            width: 220px;
            font-weight: 600;
            color: #111;
            font-size: 15px;
        }

        .spec-value {
            flex: 1;
            color: #333;
            font-size: 15px;
            line-height: 1.6;
        }

        .thongtin {
            margin-left: 60px;
            font-size: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
    </style>
    <script src="~/Scripts/script/Sanpham.js"></script>
</head>
<body>
    <div class="product-page">

        <div class="thumb">
            <div class="box active" onclick="openImage(this)">
                <img src="~/Content/image2/lotchuot.jpg" alt="">
            </div>
            <div class="box" onclick="openImage(this)">
                <img src="~/Content/image2/2.jpg" alt="">
            </div>
            <div class="box" onclick="openImage(this)">
                <img src="~/Content/image2/3.jpg" alt="">
            </div>
        </div>


        <div class="product-showcase">
            <div class="showcase-wrapper">
                <img src="~/Content/image2lotchuot" alt="" class="main-image">
            </div>
        </div>

        <div class="product-details">
            <span class="product-brand">Pulsar</span>
            <h1 class="product-title">Pulsar ParaControl V2 – Lót chuột control đa size đế cao su</h1>

            <div class="product-rating">
                <span class="stars">⭐ 5.0</span>
                <span class="reviews">(25 đánh giá)</span>
            </div>

            <div class="product-price">329.000₫</div>

            <hr class="divider">

        </div>
        </br>
        <div class="product-action-section">
            <span class="quantity-label">Số lượng:</span>
            <div class="action-wrapper">
                <div class="quantity-selector">
                    <button type="button" onclick="decreaseQty()">-</button>
                    <input type="text" id="quantity-input" value="1" readonly>
                    <button type="button" onclick="increaseQty()">+</button>
                </div>
                <button type="button" class="btn-buy-now">ADD TO CART</button>
            </div>
        </div>
    </div>
    <div class="decription">
        <div class="thongtin">
            Cân bằng giữa tốc độ và kiểm soát chuột, Pulsar ParaControl V2 là mẫu lót chuột hiếm hoi sở hữu bề mặt control nhưng vẫn giữ được tốc độ lướt tốt và dễ dàng dừng chuột khi cần.

            Trong ba loại lót chuột của Pulsar, đây là loại lót chuột trung hòa giữa tốc độ và sự kiểm soát, thích hợp với những bạn cần tìm một lót chuột an toàn, dễ làm quen để bắt đầu try hard các tựa game cũng như cần độ chính xác cao khi làm việc..</div">

        </div>
        <div class="product-specs-container">
            <div class="spec-row">
                <div class="spec-label">Chất liệu bề mặt</div>
                <div class="spec-value">Vải không dệt hoa văn control</div>
            </div>
            <div class="spec-row">
                <div class="spec-label">Chất liệu đế</div>
                <div class="spec-value">Cao su thiên nhiên dày 2-4mm chống trượt</div>
            </div>
            <div class="spec-row">
                <div class="spec-label">Kích thước</div>
                <div class="spec-value">
                    S: 260 x 210 x 2mm<br>
                    M: 330 x 260 x 4mm<br>
                    L: 420 x 330 x 4mm<br>
                    XL: 490 x 420 x 4mm<br>
                    XXL: 900 x 400 x 4mm
                </div>
            </div>
            <div class="spec-row">
                <div class="spec-label">Tương thích feet</div>
                <div class="spec-value">
                    Feet mềm (PTFE)<br>
                    Feet cứng (thủy tinh, sapphire)
                </div>
            </div>
        </div>

        </div>
</body>
</html>