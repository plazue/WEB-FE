@{
    ViewBag.Title = "signup";
    Layout = "~/Views/Home/mau1.cshtml";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng Nhập</title>
    <script src="https://kit.fontawesome.com/2ba83b9efc.js" crossorigin="anonymous"></script>
    <script src="~/Scripts/script/LI.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: white;
            color: black;
        }

        .auth-wrapper {
            min-height: calc(100vh - 70px);
            display: flex;
            justify-content: center;
            align-items: center;
            background-image: url("/content/image2/5-1.jpg");
            padding: 40px 20px;
        }

        .auth-card {
            background-color: white;
            border: 1px solid #222;
            width: 100%;
            max-width: 440px;
            padding: 40px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.9);
        }

        .auth-title {
            color: black;
            font-size: 20px;
            font-weight: 600;
            text-align: center;
            margin-bottom: 30px;
            letter-spacing: 1px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 11px;
            text-transform: uppercase;
            color: black;
            margin-bottom: 8px;
            letter-spacing: 0.5px;
        }

        .form-input {
            width: 100%;
            background-color: floralwhite;
            border: 1px solid #333;
            padding: 12px 16px;
            color: black;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }

            .form-input:focus {
                border-color: #44d62c;
            }

        .error-message {
            color: red;
            font-size: 12px;
            margin-top: 5px;
            display: none;
        }

        .forgot-password {
            text-align: right;
            margin-bottom: 24px;
        }

            .forgot-password a {
                color: black;
                font-size: 13px;
                text-decoration: none;
            }

                .forgot-password a:hover {
                    color: #302f2f;
                }

        .btn-submit {
            width: 100%;
            background-color: black;
            color: white;
            font-weight: 700;
            text-transform: uppercase;
            padding: 14px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            letter-spacing: 1px;
            transition: background-color 0.2s;
        }

            .btn-submit:hover {
                background-color: lightgray;
            }
        .btn-submit a {
            color: white;
            text-decoration: none;
        }
        .auth-switch {
            text-align: center;
            margin-top: 24px;
            font-size: 13px;
            color: black;
        }

            .auth-switch a {
                color: black;
                text-decoration: none;
                font-weight: 600;
            }

                .auth-switch a:hover {
                    color: dimgray;
                }

        .social-login {
            margin-top: 30px;
            text-align: center;
        }

            .social-login p {
                font-size: 11px;
                color: dimgray;
                margin-bottom: 15px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

        .social-icons {
            display: flex;
            justify-content: center;
            gap: 12px;
        }

        .social-btn {
            width: 38px;
            height: 38px;
            background-color: black;
            border: 1px solid #333;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            border-radius: 4px;
            text-decoration: none;
            transition: background 0.2s, border-color 0.2s;
        }

            .social-btn:hover {
                background-color: darkgray;
                border-color: #44d62c;
            }
    </style>
</head>
<body>

    <div class="auth-wrapper">
        <div class="auth-card">
            <div class="auth-title">Login</div>
      
            <form id="login-form">
                <div class="form-group">
                    <label class="form-label">Email Address</label>
          
                    <input type="email" id="email" class="form-input" required>
            
                    <div id="email-error" class="error-message">Please enter a valid email address.</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Password</label>
                   
                    <input type="password" id="password" class="form-input" required>
             
                    <div id="password-error" class="error-message">Password cannot be empty.</div>
                </div>
                <div class="forgot-password">
                    <a href="#">Forgot password?</a>
                </div>
                <button type="submit" class="btn-submit"> <a href="mainmenu">Login </a></button>
            </form>

            <div class="auth-switch">
                Don't have an account yet? <a href="dangky">Create account &gt;</a>
            </div>

            <div class="social-login">
                <p>Or log in with</p>
                <div class="social-icons">
                    <a href="#" class="social-btn"><i class="fa-brands fa-apple"></i></a>
                    <a href="#" class="social-btn"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" class="social-btn"><i class="fa-brands fa-google"></i></a>
                    <a href="#" class="social-btn"><i class="fa-brands fa-twitch"></i></a>
                    <a href="#" class="social-btn"><i class="fa-brands fa-discord"></i></a>
                </div>
            </div>
        </div>
    </div>

</body>
</html>