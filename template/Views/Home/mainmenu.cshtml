
@{
    ViewBag.Title = "mainmenu";
    Layout = "~/Views/Home/mau1.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title> Trang chủ</title>
    <script src="https://kit.fontawesome.com/2ba83b9efc.js" crossorigin="anonymous"></script>
    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif
        }

        .header {
            width: 100%;
            background-color: #3b4d9b;
            color: white;
            padding: 40px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* HOME  */
        body {
            background: #f5f6f8;
            color: #151515;
        }

        .home-wrap {
            width: 100%;
            overflow: hidden;
        }

        /* HERO SLIDER */
        .hero {
            position: relative;
            min-height: 520px;
            background: #0b0b11;
            overflow: hidden;
        }

        .hero-slide {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            opacity: 0;
            visibility: hidden;
            transition: opacity .45s ease, visibility .45s ease;
            background-size: cover;
            background-position: center;
        }

            .hero-slide.active {
                opacity: 1;
                visibility: visible;
            }

            .hero-slide::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(90deg, rgba(7, 7, 15, .92) 0%, rgba(8, 8, 18, .72) 40%, rgba(8, 8, 18, .08) 100%);
            }

        .hero-1 {
            background-image: url('https://images.unsplash.com/photo-1593305841991-05c297ba4575?auto=format&fit=crop&w=1800&q=85');
        }

        .hero-2 {
            background-image: url('https://images.unsplash.com/photo-1547394765-185e1e68f34e?auto=format&fit=crop&w=1800&q=85');
        }

        .hero-3 {
            background-image: url('https://images.unsplash.com/photo-1616588589676-62b3bd4ff6d2?auto=format&fit=crop&w=1800&q=85');
        }

        .hero-content {
            position: relative;
            z-index: 2;
            width: min(1180px, 92%);
            margin: 0 auto;
            color: #fff;
        }

        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 14px;
            padding: 8px 12px;
            border-radius: 999px;
            background: rgba(255, 255, 255, .1);
            border: 1px solid rgba(255, 255, 255, .18);
            font-size: 13px;
            font-weight: 700;
            letter-spacing: .8px;
            text-transform: uppercase;
        }

            .hero-eyebrow i {
                font-size: 12px;
            }

        .hero-title {
            max-width: 610px;
            font-size: clamp(42px, 5vw, 72px);
            line-height: .98;
            letter-spacing: -2px;
            margin-bottom: 20px;
        }

        .hero-desc {
            max-width: 530px;
            color: #d7d7df;
            line-height: 1.7;
            font-size: 16px;
            margin-bottom: 28px;
        }

        .hero-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 13px 22px;
            border: none;
            border-radius: 10px;
            background: #fff;
            color: #111;
            text-decoration: none;
            font-weight: 800;
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .hero-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(0,0,0,.22);
            }

        .hero-controls {
            position: absolute;
            z-index: 5;
            left: 50%;
            bottom: 26px;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .hero-dot {
            width: 10px;
            height: 10px;
            border: 0;
            border-radius: 50%;
            background: rgba(255,255,255,.46);
            cursor: pointer;
            transition: all .2s ease;
        }

            .hero-dot.active {
                width: 28px;
                border-radius: 999px;
                background: #fff;
            }

        .hero-pause {
            margin-left: 8px;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,.35);
            background: rgba(0,0,0,.2);
            color: #fff;
            cursor: pointer;
        }

        /* MAIN CONTAINER */
        .section {
            width: min(1180px, 92%);
            margin: 0 auto;
            padding: 58px 0;
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 20px;
            margin-bottom: 26px;
        }

            .section-heading h2 {
                font-size: clamp(27px, 3vw, 38px);
                line-height: 1.1;
                margin-bottom: 6px;
            }

            .section-heading p {
                color: #717680;
                font-size: 14px;
            }

        .see-all {
            text-decoration: none;
            color: #111;
            font-weight: 700;
            white-space: nowrap;
        }

        /* CATEGORY */
        .category-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 14px;
        }

        .category-card {
            position: relative;
            min-height: 150px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 14px;
            padding: 18px 10px;
            border: 1px solid #e7e8eb;
            border-radius: 16px;
            background: #fff;
            text-decoration: none;
            color: #191a1d;
            box-shadow: 0 5px 18px rgba(25, 26, 29, .04);
            transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        }

            .category-card:hover {
                transform: translateY(-5px);
                border-color: #d4d8df;
                box-shadow: 0 14px 28px rgba(25, 26, 29, .09);
            }

        .category-icon {
            width: 56px;
            height: 56px;
            border-radius: 15px;
            display: grid;
            place-items: center;
            background: #f2f4f7;
            font-size: 23px;
        }

        .category-card span {
            text-align: center;
            font-size: 14px;
            font-weight: 750;
        }

        /* FEATURED PRODUCTS */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        .product-card {
            position: relative;
            overflow: hidden;
            border: 1px solid #e7e8eb;
            border-radius: 18px;
            background: #fff;
            box-shadow: 0 6px 22px rgba(25, 26, 29, .045);
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .product-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 18px 35px rgba(25, 26, 29, .1);
            }

        .sale-tag {
            position: absolute;
            z-index: 2;
            top: 12px;
            left: 12px;
            padding: 6px 9px;
            border-radius: 8px;
            background: #ef4444;
            color: #fff;
            font-size: 12px;
            font-weight: 800;
        }

        .product-photo {
            height: 245px;
            padding: 18px;
            background: #f7f7f8;
        }

            .product-photo img {
                width: 100%;
                height: 100%;
                object-fit: contain;
                border-radius: 12px;
                display: block;
                background: #fff;
            }

        .product-info {
            padding: 16px 16px 18px;
        }

        .product-brand {
            color: #858a94;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            margin-bottom: 7px;
        }

        .product-name {
            min-height: 44px;
            font-size: 16px;
            line-height: 1.4;
            margin-bottom: 10px;
        }

        .product-price-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }

        .product-price {
            font-size: 18px;
            font-weight: 850;
        }

        .product-rating {
            color: #f4a300;
            font-size: 13px;
            white-space: nowrap;
        }

        /* BENEFITS */
        .benefit-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .benefit-card {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 20px;
            border-radius: 16px;
            background: #fff;
            border: 1px solid #e7e8eb;
        }

        .benefit-icon {
            flex: 0 0 46px;
            width: 46px;
            height: 46px;
            border-radius: 13px;
            display: grid;
            place-items: center;
            background: #f2f4f7;
            font-size: 18px;
        }

        .benefit-card h3 {
            font-size: 15px;
            margin-bottom: 4px;
        }

        .benefit-card p {
            color: #737780;
            font-size: 13px;
            line-height: 1.5;
        }

      
        .chat-btn {
            position: fixed;
            right: 24px;
            bottom: 24px;
            z-index: 20;
            width: 58px;
            height: 58px;
            border: 0;
            border-radius: 50%;
            background: #2196f3;
            color: #fff;
            display: grid;
            place-items: center;
            font-size: 23px;
            cursor: pointer;
            box-shadow: 0 12px 28px rgba(33, 150, 243, .33);
            transition: transform .2s ease;
        }

            .chat-btn:hover {
                transform: scale(1.06);
            }

      
        @@media (max-width: 1000px) {
            .category-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .product-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .benefit-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 600px) {
            .hero {
                min-height: 430px;
            }

            .hero-content {
                width: 88%;
            }

            .hero-title {
                font-size: 42px;
                letter-spacing: -1.2px;
            }

            .hero-desc {
                font-size: 14px;
                max-width: 95%;
            }

            .section {
                width: 90%;
                padding: 42px 0;
            }

            .section-heading {
                align-items: start;
                flex-direction: column;
            }

            .category-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .product-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 11px;
            }

            .product-photo {
                height: 155px;
                padding: 10px;
            }

            .product-info {
                padding: 12px;
            }

            .product-name {
                min-height: 58px;
                font-size: 13px;
            }

            .product-price {
                font-size: 15px;
            }

            .product-rating {
                font-size: 11px;
            }

            .chat-btn {
                right: 16px;
                bottom: 16px;
                width: 54px;
                height: 54px;
            }
            .product-card a
            {
                text-decoration: none;
                color: black;
                display: block;
            }
        }
    </style>
    <script src="~/Scripts/script/MN.js"></script>
</head>
<body>

    <!-- TRANG CHỦ -->
    <main class="home-wrap">

        <!-- BANNER -->
        <section class="hero" aria-label="Banner quảng cáo">
            <article class="hero-slide hero-1 active">
                <div class="hero-content">
                    <div class="hero-eyebrow">
                        <i class="fa-solid fa-bolt"></i>
                        Gaming gear mới
                    </div>
                    <h1 class="hero-title">Pulsar PRO<br />Susanto-X 2.0</h1>
                    <p class="hero-desc">
                        Chuột gaming không dây siêu nhẹ, thiết kế dành cho game thủ cần tốc độ,
                        độ chính xác và cảm giác cầm nắm thoải mái.
                    </p>
                    <a href="#best-seller" class="hero-btn">
                        Xem thêm <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </article>

            <article class="hero-slide hero-2">
                <div class="hero-content">
                    <div class="hero-eyebrow">
                        <i class="fa-solid fa-gamepad"></i>
                        Gaming setup
                    </div>
                    <h2 class="hero-title">Nâng cấp<br />góc game của bạn</h2>
                    <p class="hero-desc">
                        Từ chuột, bàn phím đến tai nghe và mousepad — chọn đúng gear để setup
                        vừa đẹp vừa chiến.
                    </p>
                    <a href="#categories" class="hero-btn">
                        Khám phá ngay <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </article>

            <article class="hero-slide hero-3">
                <div class="hero-content">
                    <div class="hero-eyebrow">
                        <i class="fa-solid fa-star"></i>
                        Best seller
                    </div>
                    <h2 class="hero-title">Gear xịn<br />chơi game đã</h2>
                    <p class="hero-desc">
                        Những sản phẩm được nhiều game thủ lựa chọn, nổi bật về hiệu năng và
                        thiết kế.
                    </p>
                    <a href="#best-seller" class="hero-btn">
                        Xem sản phẩm <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </article>

            <div class="hero-controls">
                <button class="hero-dot active" data-slide="0" aria-label="Banner 1"></button>
                <button class="hero-dot" data-slide="1" aria-label="Banner 2"></button>
                <button class="hero-dot" data-slide="2" aria-label="Banner 3"></button>
                <button class="hero-pause" id="heroPause" aria-label="Tạm dừng banner">
                    <i class="fa-solid fa-pause"></i>
                </button>
            </div>
        </section>

        <!-- DANH MỤC -->
        <section class="section" id="categories">
            <div class="section-heading">
                <div>
                    <h2>Danh mục chính</h2>
                    <p>Chọn nhanh nhóm sản phẩm bạn đang tìm kiếm</p>
                </div>
                <a class="see-all" href="#">Xem tất cả <i class="fa-solid fa-arrow-right"></i></a>
            </div>

            <div class="category-grid">
                <a href="#" class="category-card">
                    <div class="category-icon"><i class="fa-solid fa-computer-mouse"></i></div>
                    <span>Chuột Gaming</span>
                </a>
                <a href="#" class="category-card">
                    <div class="category-icon"><i class="fa-regular fa-keyboard"></i></div>
                    <span>Bàn phím</span>
                </a>
                <a href="#" class="category-card">
                    <div class="category-icon"><i class="fa-solid fa-headphones"></i></div>
                    <span>Tai nghe</span>
                </a>
                <a href="#" class="category-card">
                    <div class="category-icon"><i class="fa-solid fa-mouse"></i></div>
                    <span>Mousepad</span>
                </a>
                <a href="#" class="category-card">
                    <div class="category-icon"><i class="fa-solid fa-desktop"></i></div>
                    <span>Màn hình</span>
                </a>
                <a href="#" class="category-card">
                    <div class="category-icon"><i class="fa-solid fa-keyboard"></i></div>
                    <span>Phụ kiện</span>
                </a>
            </div>
        </section>
        <section class="section" id="best-seller">
            <div class="section-heading">
                <div>
                    <h2>Best Seller</h2>
                    <p>Những sản phẩm nổi bật được game thủ quan tâm</p>
                </div>
                <a class="see-all" href="#">Xem tất cả <i class="fa-solid fa-arrow-right"></i></a>
            </div>

            <div class="product-grid" id="productGrid">
                <article class="product-card" data-name="Razer BlackWidow V4 Tenkeyless HyperSpeed Wuthering Waves Edition">
                    <a href="SP2">
                        <div class="sale-tag">Giảm giá</div>
                        <div class="product-photo">
                            <img src="~/Content/image2/10.jpg" alt="Razer BlackWidow V4 Tenkeyless HyperSpeed Wuthering Waves Edition">
                        </div>
                        <div class="product-info">
                            <div class="product-brand">Razer</div>
                            <h3 class="product-name">Razer BlackWidow V4 Tenkeyless HyperSpeed Wuthering Waves Edition</h3>
                            <div class="product-price-row">
                                <strong class="product-price">3.576.000đ</strong>
                                <span class="product-rating">★ 5.0</span>
                            </div>
                        </div>
                    </a>
                </article>

                <article class="product-card" data-name="Razer Viper V3 Pro SE – Chuột đối xứng kèm dongle 1K">
                    <a href="SP3" >
                        <div class="product-photo">
                            <img src="~/Content/image2/5.jpg" alt="Razer Viper V3 Pro SE – Chuột đối xứng kèm dongle 1K">
                        </div>
                        <div class="product-info">
                            <div class="product-brand">Razer</div>
                            <h3 class="product-name">Razer Viper V3 Pro SE – Chuột đối xứng kèm dongle 1K</h3>
                            <div class="product-price-row">
                                <strong class="product-price">3.029.000₫</strong>
                                <span class="product-rating">★ 5.0</span>
                            </div>
                        </div>
                    </a>
                </article>

                <article class="product-card" data-name="Realforce × hololive GX1 Plus Keyboard Kanade Otonose Models">
                    <a href="SP1">
                        <div class="product-photo">
                            <img src="~/Content/image2/thumb**.jpg" alt="Realforce × hololive GX1 Plus Keyboard Kanade Otonose Models">
                        </div>
                        <div class="product-info">
                            <div class="product-brand">Razer</div>
                            <h3 class="product-name">Realforce × hololive GX1 Plus Keyboard Kanade Otonose Models</h3>
                            <div class="product-price-row">
                                <strong class="product-price">8.329.000₫</strong>
                                <span class="product-rating">★ 5.0</span>
                            </div>
                        </div>
                    </a>
                </article>

                <article class="product-card" data-name="Pulsar ParaControl V2 – Lót chuột control đa size đế cao su">
                    <a href="SP4">
                        <div class="product-photo">

                            <img src="~/Content/image2/3.jpg" alt="Pulsar ParaControl V2 – Lót chuột control đa size đế cao su">
                        </div>
                        <div class="product-info">
                            <div class="product-brand">Pulsar</div>
                            <h3 class="product-name">Pulsar ParaControl V2 – Lót chuột control đa size đế cao su</h3>
                            <div class="product-price-row">
                                <strong class="product-price">329.000₫</strong>
                                <span class="product-rating">★ 5.0</span>
                            </div>
                        </div>
                    </a>
                </article>
            </div>
        </section>

        <!-- DỊCH VỤ -->
        <section class="section">
            <div class="benefit-grid">
                <article class="benefit-card">
                    <div class="benefit-icon"><i class="fa-solid fa-truck-fast"></i></div>
                    <div>
                        <h3>Giao hàng nhanh</h3>
                        <p>Đóng gói kỹ và hỗ trợ giao hàng toàn quốc.</p>
                    </div>
                </article>
                <article class="benefit-card">
                    <div class="benefit-icon"><i class="fa-solid fa-shield-halved"></i></div>
                    <div>
                        <h3>Chính hãng & bảo hành</h3>
                        <p>Thông tin sản phẩm rõ ràng, hỗ trợ sau mua.</p>
                    </div>
                </article>
                <article class="benefit-card">
                    <div class="benefit-icon"><i class="fa-solid fa-headset"></i></div>
                    <div>
                        <h3>Hỗ trợ game thủ</h3>
                        <p>Tư vấn gear phù hợp theo nhu cầu và ngân sách.</p>
                    </div>
                </article>
            </div>
        </section>
    </main>

    <!-- NÚT CHAT -->
    <button class="chat-btn" type="button" aria-label="Mở hỗ trợ chat">
        <i class="fa-solid fa-message"></i>
    </button>



</body>
</html>

